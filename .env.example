# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Postgres (docker-compose reads these too)
POSTGRES_USER=pm_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
POSTGRES_PORT=5433

# ETL / migrations connect as the owner role
DATABASE_URL=postgresql://pm_admin:change-me@localhost:5433/portfolio
# The agent connects as the read-only role created in phase 1
AGENT_DATABASE_URL=postgresql://agent_ro:change-me-too@localhost:5433/portfolio

# Models
ROUTER_MODEL=claude-haiku-5-5
REASONING_MODEL=claude-sonnet-5-5

# Metric assumptions
RISK_FREE_RATE=0.065
TRADING_DAYS=252

# SQL guardrails
SQL_ROW_LIMIT=500
SQL_TIMEOUT_MS=3000
# EXPLAIN cost above which a query is refused before it runs
SQL_MAX_COST=2000000
# Claude effort for the SQL writer: low | medium | high
SQL_WRITER_EFFORT=medium
